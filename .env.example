# Learntopia Environment Variables Template
# Copy this file to '.env' and fill in your Firebase project credentials.

VITE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_APP_ID=YOUR_FIREBASE_APP_ID

# AI Tutor — URL of the deployed Gemini proxy Worker (see worker/README.md).
# The Gemini API key lives ONLY in the Worker's secret, never in the client.
VITE_GEMINI_PROXY_URL=

# --- Optional hardening (leave blank to disable; features no-op when unset) ---
# Sentry error monitoring. Public-safe DSN from a Sentry React project. When
# set, production builds report crashes to your Sentry dashboard.
VITE_SENTRY_DSN=
# Firebase App Check reCAPTCHA v3 site key. When set, the app attaches an
# attestation token so bots/scripts can't hit Firestore with your public config.
VITE_RECAPTCHA_SITE_KEY=

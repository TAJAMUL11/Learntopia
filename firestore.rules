rules_version = '2';

// Learntopia Firestore Security Rules
// Principle: deny everything by default; a signed-in user may only touch their OWN data.
// The Firebase web apiKey is public, so THESE RULES — not the key — protect the database.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---------------------------------------------------------

    // True only when the request is authenticated AND acting on its own uid.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // True when the request is from any authenticated user.
    function isSignedIn() {
      return request.auth != null;
    }

    // The owner/admin, identified by a custom claim ("admin": true) set on the
    // account via the Firebase Admin SDK. No email or PII appears in these rules
    // or in the client bundle — the claim is the sole source of admin authority.
    // This is the REAL access control behind the hidden admin portal.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Profile documents (Users/{uid}) may hold these known fields.
    function isValidProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'fullName', 'totalPoints', 'streak', 'lastLoginDate', 'badges'])
          && d.email is string
          && d.fullName is string;
    }

    // Quiz attempts are validated so a client can't write garbage or an
    // impossible score. Shape mirrors Quiz.jsx -> saveScore().
    function isValidAttempt() {
      let d = request.resource.data;
      return d.keys().hasOnly(['quizId', 'quizTitle', 'score', 'totalQuestions', 'completedAt'])
          && d.quizId is string
          && d.quizTitle is string
          && d.score is number
          && d.totalQuestions is number
          && d.score >= 0
          && d.completedAt is timestamp;
    }

    // A course enrollment may only be flagged `completed: true` once the number
    // of completed modules covers every module. Any not-yet-completed write is
    // allowed (enroll, per-module progress). This gates completion on the
    // database, not just in the UI.
    function isValidEnrollment() {
      let d = request.resource.data;
      return d.get('completed', false) == false
          || (d.completedModules is list
              && d.totalModules is number
              && d.completedModules.size() >= d.totalModules);
    }

    // Public leaderboard entries carry DISPLAY data only — never email/PII.
    // This shape check makes it impossible to write an email into the
    // world-readable PublicLeaderboard collection.
    function isValidPublicEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'fullName', 'totalPoints', 'streak', 'badges', 'updatedAt']);
    }

    // Security check for profile updates (cheating prevention)
    function isValidProfileUpdate(userId) {
      let current = resource.data;
      let next = request.resource.data;

      // Prevent points cheating:
      // 1. totalPoints can only increase or stay the same.
      // 2. totalPoints cannot jump by more than 200 points in a single write (max quiz bonus).
      let currentPoints = current.get('totalPoints', 0);
      let nextPoints = next.get('totalPoints', 0);
      let pointsDiff = nextPoints - currentPoints;

      // Prevent badges cheating:
      // 1. Badges list size must be equal to or greater than before (no deleting badges).
      // 2. Existing badges must not be modified or cleared.
      let currentBadges = current.get('badges', []);
      let nextBadges = next.get('badges', []);

      return isValidProfile()
          && pointsDiff >= 0
          && pointsDiff <= 200
          && nextBadges.size() >= currentBadges.size()
          && (currentBadges.size() == 0 || nextBadges.hasAll(currentBadges));
    }

    // --- User profile ----------------------------------------------------

    match /Users/{userId} {
      // Owner reads own profile; admin may read ALL profiles (backend access).
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidProfile();
      allow update: if isOwner(userId) && isValidProfileUpdate(userId);
      allow delete: if false; // profiles are not deleted from the client

      // --- Quiz attempts (append-only history) --------------------------
      // Owner can read and add attempts (admin may read any); nobody edits or
      // deletes past ones — this keeps the score record tamper-evident.
      match /quizAttempts/{attemptId} {
        allow read:   if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidAttempt();
        allow update, delete: if false;
      }

      // --- Enrolled courses + progress ------------------------------------
      // Owner-only writes (admin may read any). Enroll and per-module progress
      // writes are allowed; flagging completed requires all modules done.
      match /enrolledCourses/{courseId} {
        allow read:   if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEnrollment();
      }
    }

    // --- Quiz Leaderboards -----------------------------------------------
    // Any authenticated user may read quiz leaderboards (needed for the
    // Leaderboard page). A user may only write their OWN score entry.
    match /QuizLeaderboards/{quizId}/Scores/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // --- Public Leaderboard ----------------------------------------------
    // Any authenticated user may read (needed for the Global Leaderboard tab).
    // A user may only write/update their OWN entry, and the shape check ensures
    // NO email/PII is ever stored in this world-readable collection.
    match /PublicLeaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidPublicEntry();
    }

    // --- Contact Messages ------------------------------------------------
    // Anyone (including unauthenticated visitors) may submit a contact form.
    // No client-side reads, updates, or deletes — messages are reviewed via
    // the Firebase Console only.
    function isValidContactMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'subject', 'message', 'submittedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.email is string && d.email.size() > 0 && d.email.size() <= 200
          && d.subject is string
          && d.message is string && d.message.size() >= 10 && d.message.size() <= 1000;
    }

    match /ContactMessages/{msgId} {
      allow create: if isValidContactMessage();
      allow read:   if isAdmin();          // admin reviews inquiries in-app
      allow update, delete: if false;
    }

    // --- Bug reports / system notes --------------------------------------
    // Admin-only: the owner logs and reviews technical notes from the portal.
    match /BugReports/{bugId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // --- Default deny ----------------------------------------------------
    // Anything not matched above is fully locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
